# Copy to .env and replace these examples with local values.
# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-unique-random-secret
# Optional: defaults to SQLite at instance/eip.db
# DATABASE_URL=sqlite:///eip.db

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
